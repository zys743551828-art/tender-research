      },
      "source_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Source Sha256",
        "type": "string"
      },
      "source_path": {
        "title": "Source Path",
        "type": "string"
      },
      "source_ids": {
        "items": {
          "type": "string"
        },
        "title": "Source Ids",
        "type": "array"
      },
      "pdf_page": {
        "exclusiveMinimum": 0,
        "title": "Pdf Page",
        "type": "integer"
      },
      "start_char": {
        "minimum": 0,
        "title": "Start Char",
        "type": "integer"
      },
      "end_char": {
        "exclusiveMinimum": 0,
        "title": "End Char",
        "type": "integer"
      },
      "quote": {
        "minLength": 1,
        "title": "Quote",
        "type": "string"
      },
      "kind": {
        "const": "source_excerpt",
        "title": "Kind",
        "type": "string"
      },
      "retrieval_score": {
        "title": "Retrieval Score",
        "type": "number"
      }
    },
    "required": [
      "file_id",
      "source_sha256",
      "source_path",
      "source_ids",
      "pdf_page",
      "start_char",
      "end_char",
      "quote",
      "kind",
      "retrieval_score"
    ],
    "title": "Evidence",
    "type": "object"
  },
  "OfficialLabel": {
    "additionalProperties": false,
    "properties": {
      "target": {
        "enum": [
          "technical_total",
          "composite_total"
