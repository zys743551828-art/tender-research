  },
  "ReportedResult": {
    "additionalProperties": false,
    "description": "用户报送结果单独保存；不能自动升级为官方监督标签。",
    "properties": {
      "result_id": {
        "title": "Result Id",
        "type": "string"
      },
      "source_kind": {
        "const": "user_statement",
        "title": "Source Kind",
        "type": "string"
      },
      "received_date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "title": "Received Date",
        "type": "string"
      },
      "source_description": {
        "minLength": 1,
        "title": "Source Description",
        "type": "string"
      },
      "verification_status": {
        "const": "official_source_pending",
        "title": "Verification Status",
        "type": "string"
      },
      "target": {
        "enum": [
          "technical_total",
          "composite_total"
        ],
        "title": "Target",
        "type": "string"
      },
      "target_interpretation": {
        "minLength": 1,
        "title": "Target Interpretation",
        "type": "string"
      },
      "value": {
        "minimum": 0,
        "title": "Value",
        "type": "number"
      },
      "maximum": {
        "exclusiveMinimum": 0,
        "title": "Maximum",
        "type": "number"
      },
      "reported_shortlist_cutoff": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reported Shortlist Cutoff"
      },
      "cutoff_scope_status": {
        "title": "Cutoff Scope Status",
        "type": "string"
      },
      "submission_file_id": {
        "title": "Submission File Id",
        "type": "string"
      },
      "submission_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Submission Sha256",
        "type": "string"
      },
      "official_training_eligible": {
        "const": false,
        "title": "Official Training Eligible",
        "type": "boolean"
      }
    },
    "required": [
      "result_id",
      "source_kind",
      "received_date",
      "source_description",
      "verification_status",
      "target",
      "target_interpretation",
      "value",
      "maximum",
      "cutoff_scope_status",
      "submission_file_id",
      "submission_sha256",
      "official_training_eligible"
    ],
    "title": "ReportedResult",
    "type": "object"
  },
  "PairSample": {
    "$defs": {
      "LabelItem": {
        "additionalProperties": true,
        "description": "官方分项得分；同一分项可有多位评委各一行。",
        "properties": {
          "item": {
            "minLength": 1,
            "title": "Item",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value"
          },
          "maximum": {
            "exclusiveMinimum": 0,
            "title": "Maximum",
            "type": "number"
          },
          "evaluator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evaluator"
          }
        },
        "required": [
          "item",
          "maximum"
        ],
        "title": "LabelItem",
        "type": "object"
      },
      "PairBody": {
        "additionalProperties": true,
        "properties": {
          "file_id": {
            "title": "File Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "pages": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pages"
          },
          "text_layer": {
            "title": "Text Layer",
            "type": "boolean"
          }
        },
        "required": [
          "file_id",
          "path",
          "sha256",
          "text_layer"
        ],
        "title": "PairBody",
        "type": "object"
      },
      "PairFile": {
        "additionalProperties": true,
        "properties": {
          "file_id": {
            "title": "File Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "pages": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pages"
          },
          "role": {
            "enum": [
              "tender",
              "addendum"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "path",
          "sha256",
          "role"
        ],
        "title": "PairFile",
        "type": "object"
      },
      "PairLabel": {
        "additionalProperties": true,
        "properties": {
          "target": {
            "enum": [
              "technical_total",
              "composite_total"
            ],
            "title": "Target",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "maximum": {
            "exclusiveMinimum": 0,
            "title": "Maximum",
            "type": "number"
          },
          "verification_status": {
            "enum": [
              "verified",
              "pending"
            ],
            "title": "Verification Status",
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "official_document",
              "company_ledger",
              "user_statement"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "known_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Known At"
          },
          "stage_result": {
            "anyOf": [
              {
                "enum": [
                  "shortlisted",
                  "not_shortlisted",
                  "rejected",
                  "awarded",
                  "not_awarded",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stage Result"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/LabelItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "target",
          "value",
          "maximum",
          "verification_status",
          "source_kind"
        ],
        "title": "PairLabel",
        "type": "object"
      }
    },
    "additionalProperties": true,
    "description": "交接格式 A 的一份样本：某项目／标段下某企业的一次实际提交。",
    "properties": {
      "sample_id": {
        "minLength": 1,
        "title": "Sample Id",
        "type": "string"
      },
      "project_key": {
        "minLength": 1,
        "title": "Project Key",
        "type": "string"
      },
      "template_group": {
        "minLength": 1,
        "title": "Template Group",
        "type": "string"
      },
      "region": {
        "title": "Region",
        "type": "string"
      },
      "engineering_type": {
        "title": "Engineering Type",
        "type": "string"
      },
      "scoring_scheme": {
        "title": "Scoring Scheme",
        "type": "string"
      },
      "bidder": {
        "title": "Bidder",
        "type": "string"
      },
      "own_company": {
        "title": "Own Company",
        "type": "boolean"
      },
      "submitted_at": {
        "format": "date",
        "title": "Submitted At",
        "type": "string"
      },
      "tender_files": {
        "items": {
          "$ref": "#/$defs/PairFile"
        },
        "title": "Tender Files",
        "type": "array"
      },
      "body_file": {
        "anyOf": [
          {
            "$ref": "#/$defs/PairBody"
          },
          {
            "type": "null"
          }
        ]
      },
      "label": {
        "anyOf": [
          {
            "$ref": "#/$defs/PairLabel"
          },
          {
            "type": "null"
          }
        ]
      },
      "eligible": {
        "title": "Eligible",
        "type": "boolean"
      },
      "exclusion": {
        "anyOf": [
          {
            "enum": [
              "missing_label",
              "composite_not_technical",
              "no_text_layer",
              "duplicate_body",
              "missing_files",
              "score_out_of_range"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Exclusion"
      }
    },
    "required": [
      "sample_id",
      "project_key",
      "template_group",
      "region",
      "engineering_type",
      "scoring_scheme",
      "bidder",
      "own_company",
      "submitted_at",
      "tender_files",
      "body_file",
      "label",
      "eligible",
      "exclusion"
    ],
    "title": "PairSample",
    "type": "object"
  },
  "SystemPrediction": {
    "$defs": {
      "PredictedItem": {
        "additionalProperties": true,
        "description": "分项预测；上游追加的数值键（如 grade_index、coverage）按分值加权聚合为特征。",
        "properties": {
          "statement": {
            "default": "",
            "title": "Statement",
            "type": "string"
          },
          "max_points": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Points"
          },
          "estimate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Estimate"
          },
          "low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Low"
          },
          "high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "High"
          },
          "failed": {
            "default": false,
            "title": "Failed",
            "type": "boolean"
          }
        },
        "title": "PredictedItem",
        "type": "object"
      },
      "PredictedTotal": {
        "additionalProperties": true,
        "properties": {
          "status": {
            "enum": [
              "candidate",
              "abstained"
            ],
            "title": "Status",
            "type": "string"
          },
          "estimate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Estimate"
          },
          "low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Low"
          },
          "high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "High"
          },
          "maximum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Maximum"
          }
        },
        "required": [
          "status"
        ],
        "title": "PredictedTotal",
        "type": "object"
      },
      "PredictionExtra": {
        "additionalProperties": true,
        "description": "产品后端计算并随预测保存的评分特征（feature_spec 如 pf-1）；值为数值或 null。",
        "properties": {
          "feature_spec": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Feature Spec"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Features",
            "type": "object"
          }
        },
        "title": "PredictionExtra",
        "type": "object"
      },
      "PredictionInputs": {
        "additionalProperties": true,
        "properties": {
          "tender_sha256": {
            "items": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "title": "Tender Sha256",
            "type": "array"
          },
          "body_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Body Sha256",
            "type": "string"
          }
        },
        "required": [
          "tender_sha256",
          "body_sha256"
        ],
        "title": "PredictionInputs",
        "type": "object"
      }
    },
    "additionalProperties": true,
    "description": "交接格式 B：系统对单份样本的批量预测；只由招标文件与正文产生。",
    "properties": {
      "schema": {
        "const": "system-prediction/1",
        "title": "Schema",
        "type": "string"
      },
      "sample_id": {
        "title": "Sample Id",
        "type": "string"
      },
      "status": {
        "enum": [
          "succeeded",
          "failed"
        ],
        "title": "Status",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      },
      "fingerprint": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fingerprint"
      },
      "model": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model"
      },
      "prompt_version": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Prompt Version"
      },
      "code_sha256": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Code Sha256"
      },
      "inputs": {
        "$ref": "#/$defs/PredictionInputs"
      },
      "technical_full_score": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Technical Full Score"
      },
      "prediction": {
        "anyOf": [
          {
            "$ref": "#/$defs/PredictedTotal"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "items": {
        "items": {
          "$ref": "#/$defs/PredictedItem"
        },
        "title": "Items",
        "type": "array"
      },
      "compliance": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Compliance"
      },
      "findings": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Findings"
      },
      "body": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Body"
      },
      "artifact_extra": {
        "anyOf": [
          {
            "$ref": "#/$defs/PredictionExtra"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "schema",
      "sample_id",
      "status",
      "inputs"
    ],
    "title": "SystemPrediction",
    "type": "object"
  },
  "EvalProtocol": {
    "$defs": {
      "EvalCV": {
        "additionalProperties": false,
        "properties": {
          "folds": {
            "default": 5,
            "minimum": 2,
            "title": "Folds",
            "type": "integer"
          },
          "repeats": {
            "default": 3,
            "minimum": 1,
            "title": "Repeats",
            "type": "integer"
          }
        },
        "title": "EvalCV",
        "type": "object"
      },
      "EvalFeatures": {
        "additionalProperties": false,
        "properties": {
          "include": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Include",
            "type": "array"
          },
          "exclude": {
            "items": {
              "type": "string"
            },
            "title": "Exclude",
            "type": "array"
          }
        },
        "required": [
          "include"
        ],
        "title": "EvalFeatures",
        "type": "object"
      },
      "EvalHoldout": {
        "additionalProperties": false,
        "properties": {
          "test_fraction": {
            "default": 0.2,
            "exclusiveMinimum": 0,
            "maximum": 0.5,
            "title": "Test Fraction",
            "type": "number"
          },
          "min_test_samples": {
            "default": 10,
            "minimum": 1,
            "title": "Min Test Samples",
            "type": "integer"
          }
        },
        "title": "EvalHoldout",
        "type": "object"
      },
      "EvalKnn": {
        "additionalProperties": false,
        "properties": {
          "k": {
            "default": 10,
            "minimum": 1,
            "title": "K",
            "type": "integer"
          },
          "ngrams": {
            "default": [
              2,
              3
            ],
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "title": "Ngrams",
            "type": "array"
          },
          "hash_bits": {
            "default": 18,
            "maximum": 22,
            "minimum": 10,
            "title": "Hash Bits",
            "type": "integer"
          }
        },
        "title": "EvalKnn",
        "type": "object"
      },
      "EvalMinimums": {
        "additionalProperties": false,
        "properties": {
          "labeled_samples": {
            "default": 30,
            "minimum": 1,
            "title": "Labeled Samples",
            "type": "integer"
          },
          "independent_projects": {
            "default": 10,
            "minimum": 1,
            "title": "Independent Projects",
            "type": "integer"
          },
          "slice_samples": {
            "default": 10,
            "minimum": 1,
            "title": "Slice Samples",
            "type": "integer"
          },
          "ranking_projects": {
            "default": 5,
            "minimum": 1,
            "title": "Ranking Projects",
            "type": "integer"
          },
          "shortlist_samples": {
            "default": 20,
            "minimum": 1,
