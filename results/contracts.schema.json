        "title": "Target",
        "type": "string"
      },
      "value": {
        "minimum": 0,
        "title": "Value",
        "type": "number"
      },
      "maximum": {
        "exclusiveMinimum": 0,
        "title": "Maximum",
        "type": "number"
      },
      "source_file_id": {
        "title": "Source File Id",
        "type": "string"
      },
      "source_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Source Sha256",
        "type": "string"
      },
      "source_pdf_page": {
        "exclusiveMinimum": 0,
        "title": "Source Pdf Page",
        "type": "integer"
      },
      "submission_id": {
        "title": "Submission Id",
        "type": "string"
      },
      "aggregation": {
        "minLength": 1,
